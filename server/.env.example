# Copy to .env and fill in. Never commit .env.
PORT=5000
NODE_ENV=development
# Frontend origin(s), comma separated. In production: your Vercel URL(s), no trailing slash.
CLIENT_URL=http://localhost:5173

# MongoDB Atlas
MONGO_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?appName=Cluster0
MONGO_DB_NAME=meritlab

# Generate each with: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRE=30d

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Brevo SMTP. On Render free use SMTP_PORT=2525 (587/465/25 are blocked there).
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Seed (npm run seed): first super admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Cron secret (openssl rand -hex 24)
CRON_SECRET=
