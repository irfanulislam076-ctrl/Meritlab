# MongoDB. Atlas (free M0 works) or a local replica set: payments and result publishing use transactions.
# Local single-node replica set example: mongodb://localhost:27017/meritlab?directConnection=true
MONGODB_URI="mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/meritlab?retryWrites=true&w=majority"

# Session signing key. Generate one with: openssl rand -base64 48
JWT_SECRET=""

# Brevo transactional email. Leave BREVO_API_KEY empty in development
# and OTP codes are printed in the server console instead.
BREVO_API_KEY=""
BREVO_SENDER_EMAIL="no-reply@example.com"
BREVO_SENDER_NAME="Meritlab"

# File storage (Cloudflare R2 or Supabase Storage, S3-compatible)
STORAGE_ENDPOINT=""
STORAGE_REGION="auto"
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_PUBLIC_BASE_URL=""

# First super admin, created by the seed script
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Protects /api/cron/* (Vercel Cron sends it as a Bearer token)
CRON_SECRET=""

# Frontend: URL of the Express backend (server/). Local: http://localhost:5000
# Production (Vercel): your Render URL, e.g. https://meritlab-api.onrender.com
NEXT_PUBLIC_API_URL="http://localhost:5000"
